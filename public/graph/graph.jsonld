    "date": "2026-09-11",
    "evidenceAccessed": [
     "hrm:source/rouwkema-2016-trendsbiotech",
     "hrm:source/laschke-2016-biotechadv"
    ]
   },
   "review": {
    "state": "ai-proposed",
    "date": "2026-09-11"
   },
   "derivedRelations": {
    "enables": [
     "hrm:goal/established-scar-repair",
     "hrm:goal/skin-structural-reconstruction"
    ],
